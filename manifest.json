{
  "manifest_version": 3,
  "name": "Brasil Participativo — Automação Consulta IBAMA",
  "version": "1.1.0",
  "description": "Automatiza o envio de contribuições na consulta pública da Portaria Ibama nº 214/2026 no Brasil Participativo.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Automação Consulta Pública IBAMA",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://brasilparticipativo.presidencia.gov.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://brasilparticipativo.presidencia.gov.br/processes/*/f/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}